# --- core ---
PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_secret
FRONTEND_URL=https://my-blood-connect.vercel.app

# --- admin / auth ---
# comma separated emails that are auto-promoted to admin on server start
ADMIN_EMAILS=admin@example.com
# OTP / refresh token lifetimes (optional)
OTP_MINUTES=10
REFRESH_TOKEN_DAYS=7

# --- email (SMTP via nodemailer). leave empty -> console fallback in dev ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp_user
SMTP_PASS=smtp_pass
SMTP_FROM="Blood Connect <no-reply@example.com>"
# scheduled weekly digest email target (optional)
DIGEST_EMAIL=admin@example.com

# --- SMS (Twilio). leave empty -> console fallback in dev ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- web push (generate with: npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- social login (optional) ---
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- misc ---
# skip the background scheduler (escalation/reminders/digest) if set to true
DISABLE_SCHEDULER=false
# salt for jitsi video room names
VIDEO_ROOM_SALT=change-me
